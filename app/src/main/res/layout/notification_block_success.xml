<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/bg_notification_premium"
    android:padding="8dp">

    <FrameLayout
        android:id="@+id/icon_container" 
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_icon_cyan_glow">
        
        <ImageView
            android:id="@+id/notif_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_shield_large"
            android:tint="#FFFFFF" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_toEndOf="@id/icon_container"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_block_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F8FAFC"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_block_reason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#94A3B8"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/notif_arrow"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_arrow_down" />

</RelativeLayout>